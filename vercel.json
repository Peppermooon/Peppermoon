{
  "functions": {
    "api/article-preview.mjs": {
      "includeFiles": "article.html"
    },
    "api/post-preview.mjs": {
      "includeFiles": "post.html"
    },
    "api/rating-preview.mjs": {
      "includeFiles": "rating.html"
    }
  },
  "routes": [
    {
      "src": "/sitemap\\.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/index\\.html",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/community\\.html",
      "status": 308,
      "headers": {
        "Location": "/community"
      }
    },
    {
      "src": "/ratings\\.html",
      "status": 308,
      "headers": {
        "Location": "/ratings"
      }
    },
    {
      "src": "/about\\.html",
      "status": 308,
      "headers": {
        "Location": "/about"
      }
    },
    {
      "src": "/community",
      "dest": "/community.html"
    },
    {
      "src": "/ratings",
      "dest": "/ratings.html"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/articles/([^/]+)",
      "dest": "/api/article-preview?slug=$1"
    },
    {
      "src": "/article/([^/]+)",
      "dest": "/api/article-preview?slug=$1"
    },
    {
      "src": "/article\\.html",
      "dest": "/api/article-preview"
    },
    {
      "src": "/ratings/([^/]+)",
      "dest": "/api/rating-preview?slug=$1"
    },
    {
      "src": "/rating/([^/]+)",
      "dest": "/api/rating-preview?slug=$1"
    },
    {
      "src": "/rating\\.html",
      "dest": "/api/rating-preview"
    },
    {
      "src": "/posts/([^/]+)",
      "dest": "/api/post-preview?slug=$1"
    },
    {
      "src": "/post/([^/]+)",
      "dest": "/api/post-preview?slug=$1"
    },
    {
      "src": "/post\\.html",
      "dest": "/api/post-preview"
    },
    {
      "handle": "filesystem"
    }
  ]
}
