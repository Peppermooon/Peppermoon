{
  "functions": {
    "api/article-preview.mjs": {
      "includeFiles": "article.html"
    },
    "api/post-preview.mjs": {
      "includeFiles": "post.html"
    },
    "api/rating-preview.mjs": {
      "includeFiles": "rating.html"
    },
    "api/news-generate.mjs": {
      "maxDuration": 60
    },
    "api/news-inbox.mjs": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/sitemap\\.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/index\\.html",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "/community\\.html",
      "status": 308,
      "headers": {
        "Location": "/community"
      }
    },
    {
      "src": "/ratings\\.html",
      "status": 308,
      "headers": {
        "Location": "/ratings"
      }
    },
    {
      "src": "/about\\.html",
      "status": 308,
      "headers": {
        "Location": "/about"
      }
    },
    {
      "src": "/community",
      "dest": "/community.html"
    },
    {
      "src": "/ratings",
      "dest": "/ratings.html"
    },
    {
      "src": "/about",
      "dest": "/about.html"
    },
    {
      "src": "/guides",
      "dest": "/guides/index.html"
    },
    {
      "src": "/guides/star-wars",
      "dest": "/guides/star-wars-watch-order.html"
    },
    {
      "src": "/guides/star-trek",
      "dest": "/guides/star-trek-watch-order.html"
    },
    {
      "src": "/guides/predator",
      "dest": "/guides/predator-movies-watch-order.html"
    },
    {
      "src": "/guides/lord-of-the-rings",
      "dest": "/guides/lord-of-the-rings-watch-order.html"
    },
    {
      "src": "/guides/fast-and-furious",
      "dest": "/guides/fast-and-furious-watch-order.html"
    },
    {
      "src": "/guides/marvel-cinematic-universe",
      "dest": "/guides/marvel-mcu-movies-watch-order.html"
    },
    {
      "src": "/guides/x-men",
      "dest": "/guides/x-men-movies-watch-order.html"
    },
    {
      "src": "/guides/transformers",
      "dest": "/guides/transformers-movies-watch-order.html"
    },
    {
      "src": "/guides/alien",
      "dest": "/guides/alien-movies-watch-order.html"
    },
    {
      "src": "/guides/harry-potter",
      "dest": "/guides/harry-potter-movies-watch-order.html"
    },
    {
      "src": "/guides/assassins-creed",
      "dest": "/guides/assassins-creed-games-watch-order.html"
    },
    {
      "src": "/guides/final-fantasy",
      "dest": "/guides/final-fantasy-games-watch-order.html"
    },
    {
      "src": "/guides/resident-evil",
      "dest": "/guides/resident-evil-games-watch-order.html"
    },
    {
      "src": "/guides/tomb-raider",
      "dest": "/guides/tomb-raider-games-watch-order.html"
    },
    {
      "src": "/guides/metal-gear",
      "dest": "/guides/metal-gear-games-watch-order.html"
    },
    {
      "src": "/guides/like-a-dragon",
      "dest": "/guides/like-a-dragon-yakuza-games-watch-order.html"
    },
    {
      "src": "/guides/star-wars-games",
      "dest": "/guides/star-wars-games-watch-order.html"
    },
    {
      "src": "/articles/([^/]+)",
      "dest": "/api/article-preview?slug=$1"
    },
    {
      "src": "/article/([^/]+)",
      "dest": "/api/article-preview?slug=$1"
    },
    {
      "src": "/article\\.html",
      "dest": "/api/article-preview"
    },
    {
      "src": "/ratings/([^/]+)",
      "dest": "/api/rating-preview?slug=$1"
    },
    {
      "src": "/rating/([^/]+)",
      "dest": "/api/rating-preview?slug=$1"
    },
    {
      "src": "/rating\\.html",
      "dest": "/api/rating-preview"
    },
    {
      "src": "/posts/([^/]+)",
      "dest": "/api/post-preview?slug=$1"
    },
    {
      "src": "/post/([^/]+)",
      "dest": "/api/post-preview?slug=$1"
    },
    {
      "src": "/post\\.html",
      "dest": "/api/post-preview"
    },
    {
      "handle": "filesystem"
    }
  ]
}
