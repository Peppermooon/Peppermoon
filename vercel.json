{
  "functions": {
    "api/article-preview.mjs": {
      "includeFiles": "article.html"
    },
    "api/post-preview.mjs": {
      "includeFiles": "post.html"
    },
    "api/rating-preview.mjs": {
      "includeFiles": "rating.html"
    },
    "api/news-generate.mjs": {
      "maxDuration": 60
    },
    "api/news-inbox.mjs": {
      "maxDuration": 30
    },
    "api/top-ten.mjs": {
      "includeFiles": "ratings.html"
    }
  },
  "routes": [
    {
      "src": "/top-10/?",
      "status": 308,
      "headers": {
        "Location": "/top-10/movies/action"
      }
    },
    {
      "src": "/top-10/(movies|tv|gaming)/?",
      "status": 308,
      "headers": {
        "Location": "/top-10/$1/action"
      }
    },
    {
      "src": "/top-10/(movies|tv|gaming)/([a-z0-9-]+)/",
      "status": 308,
      "headers": {
        "Location": "/top-10/$1/$2"
      }
    },
    {
      "src": "/top-10/(movies|tv|gaming)/([a-z0-9-]+)",
      "dest": "/api/top-ten?medium=$1&genre=$2"
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/index\\.html",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
